# fmcw3-sim: simulation and RF-analysis tools (ngspice, scikit-rf, openEMS, Wine). Separate
# from fmcw3-tools; no KiCad. Build: docker build -t fmcw3-sim -f docker/Dockerfile.sim docker/
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git python3 python3-venv python3-pip python3-numpy python3-scipy \
      python3-matplotlib python3-pytest ngspice \
 && rm -rf /var/lib/apt/lists/*

# scikit-rf from PyPI into a venv that sees the apt numpy/scipy.
RUN python3 -m venv --system-site-packages /opt/simvenv \
 && /opt/simvenv/bin/pip install --no-cache-dir scikit-rf
ENV PATH=/opt/simvenv/bin:$PATH

# openEMS (FDTD) built from source; not packaged for Ubuntu 24.04.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential cmake libhdf5-dev libtinyxml-dev libcgal-dev libvtk9-dev \
      libboost-all-dev libopenmpi-dev gengetopt help2man groff \
      libqt5opengl5-dev cython3 python3-dev python3-h5py \
 && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --recursive https://github.com/thliebig/openEMS-Project.git /opt/openEMS-Project \
 && cd /opt/openEMS-Project \
 && ./update_openEMS.sh /opt/openEMS --python --disable-GUI \
 && rm -rf /opt/openEMS-Project/.git
ENV LD_LIBRARY_PATH=/opt/openEMS/lib PATH=/opt/openEMS/bin:$PATH

# Wine for the optional LTspice / ADIsimPLL attempt (no GUI; xvfb for headless).
RUN apt-get update \
 && apt-get install -y --no-install-recommends wine xvfb xauth \
 && rm -rf /var/lib/apt/lists/*

# pip's numpy 2 (pulled in by scikit-rf) shadows the apt numpy; apt's h5py is built against 1.x.
RUN /opt/simvenv/bin/pip install --no-cache-dir --ignore-installed h5py

# Ubuntu's wine needs the 32-bit half for msiexec/wineboot (LTspice's .msi installer).
RUN dpkg --add-architecture i386 \
 && apt-get update \
 && apt-get install -y --no-install-recommends wine32:i386 \
 && rm -rf /var/lib/apt/lists/*

# spicelib drives LTspice (and ngspice) from Python.
RUN /opt/simvenv/bin/pip install --no-cache-dir spicelib

# LTspice under Wine, installed unattended at build time. The installer is downloaded here
# (ADI's public link, no registration) and deleted again; it is never committed.
# - The prefix is /opt/wineprefix, made world-writable: Wine insists the prefix dir belongs to
#   the caller, so tests/sim/ltspice_smoke.py builds a per-run dir of symlinks into it.
# - LTspice's first run shows a "share usage data" dialog that blocks batch mode; the ini key
#   CaptureAnalytics=false answers it. That run also unpacks lib.zip (the ADI model library).
ENV WINEPREFIX=/opt/wineprefix WINEDEBUG=-all
RUN curl -fsSL -o /tmp/LTspice64.msi https://ltspice.analog.com/software/LTspice64.msi \
 && xvfb-run -a wine msiexec /i Z:\\tmp\\LTspice64.msi /qn \
 && wineserver -w \
 && rm /tmp/LTspice64.msi \
 && mkdir -p /opt/wineprefix/drive_c/users/root/AppData/Roaming \
 && printf '[Options]\nCaptureAnalytics=false\n' \
      > /opt/wineprefix/drive_c/users/root/AppData/Roaming/LTspice.ini \
 && printf '* warm-up\nV1 a 0 1\nR1 a 0 1k\n.op\n.end\n' > /tmp/warm.net \
 && xvfb-run -a wine 'C:\Program Files\ADI\LTspice\LTspice.exe' -b 'Z:\tmp\warm.net' \
 && wineserver -w \
 && test -f /opt/wineprefix/drive_c/users/root/AppData/Local/LTspice/lib/sub/LTC2.lib \
 && rm -f /tmp/warm.* \
 && chmod -R a+rwX /opt/wineprefix
ENV LTSPICE_PREFIX=/opt/wineprefix

ENV HOME=/tmp
WORKDIR /work
CMD ["bash"]
