# Copy to .env and fill in. .env is gitignored; never commit it.
# `./run` passes .env into the Docker container; parts/check_digikey.py also reads it natively.
# Steps to get keys: docs/setup.md.

# DigiKey API client id (parts/check_digikey.py). From a DigiKey developer portal organization/app.
DIGIKEY_CLIENT_ID=

# DigiKey API client secret (parts/check_digikey.py). Same app as the client id.
DIGIKEY_CLIENT_SECRET=

# Add further keys here (for example JLCPCB) when a tool starts reading them.
